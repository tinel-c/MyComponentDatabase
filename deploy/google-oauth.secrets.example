# Google OAuth — local only (gitignored).
# Copy from google-oauth.secrets.example if this file is missing:
#   copy deploy\google-oauth.secrets.example deploy\google-oauth.secrets
#
# Fill these after creating a Web application client in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URIs on that client must include:
#   https://part-db.bogza.ro/api/auth/callback/google
#   https://bnab.bogza.ro/api/auth/callback/google
# Optional local:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3010/api/auth/callback/google

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
