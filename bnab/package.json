{
  "name": "bnab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev -p 3010",
    "build": "prisma generate && next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test src/lib/budget-engine/*.test.ts src/lib/ing-import/*.test.ts src/lib/yngsb-banner.test.ts src/lib/receipt-ai/*.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@nivo/theming": "^0.99.0",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
