# Database (SQLite — separate from warehouse.db)
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-string"
AUTH_URL="http://localhost:3010"

# Google OAuth — add redirect: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# First admin (must match Google account)
ADMIN_EMAIL="tinel.c@gmail.com"

# Optional local-dev login email
# LOCAL_DEV_LOGIN_EMAIL=""

# Gemini receipt detailing (Google AI Studio / Gemini API key)
GEMINI_API_KEY=""
# Optional model override (default gemini-3.6-flash)
# GEMINI_MODEL="gemini-3.6-flash"

# Optional receipt image storage (default: .data/receipts)
# BNAB_RECEIPT_DIR=""
