# Database (SQLite — separate from warehouse.db)
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-string"
AUTH_URL="http://localhost:3010"
# Production SSO only (leave unset on localhost):
# AUTH_URL="https://bnab.bogza.ro"
# AUTH_COOKIE_DOMAIN=".bogza.ro"
# Share AUTH_SECRET with part-db when enabling cross-subdomain SSO (see docs/deploy.md).

# Google OAuth — add redirect: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# First admin (must match Google account)
ADMIN_EMAIL="tinel.c@gmail.com"

# Optional local-dev login email
# LOCAL_DEV_LOGIN_EMAIL=""

# Gemini receipt detailing (Google AI Studio / Gemini API key)
GEMINI_API_KEY=""
# Optional model override (default gemini-3.6-flash)
# GEMINI_MODEL="gemini-3.6-flash"

# Optional receipt image storage (default: .data/receipts)
# BNAB_RECEIPT_DIR=""

# Salt Edge Partners AIS (bank sync) — see docs/salt-edge-open-banking.md
# Pending mode: App-id + Secret only. LIVE requires RSA request signing.
# SALTEDGE_APP_ID=""
# SALTEDGE_SECRET=""
# PEM private key (or path). Required before Salt Edge LIVE upgrade.
# SALTEDGE_PRIVATE_KEY=""
# SALTEDGE_PRIVATE_KEY_PATH=""
# After-connect return URL (default: {AUTH_URL}/more/bank-connections)
# SALTEDGE_RETURN_TO=""
# Override callback verify key if Salt Edge rotates (defaults to docs v5.0 PEM in code)
# SALTEDGE_CALLBACK_PUBLIC_KEY=""
# Payment Initiation — keep false until Phase 4 decision gate
# SALTEDGE_PIS_ENABLED="false"
